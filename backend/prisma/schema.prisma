generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            BigInt    @id @default(autoincrement())
  email         String    @unique
  password_hash String
  name          String
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt
  enrollments   Enrollment[]
  video_progress VideoProgress[]
  refresh_tokens RefreshToken[]
  payments      Payment[]
  notes         Note[]
  bookmarks     Bookmark[]
  quiz_results  QuizResult[]
  comments      Comment[]
}

model Subject {
  id           BigInt    @id @default(autoincrement())
  title        String
  slug         String    @unique
  description  String?   @db.Text
  is_published Boolean   @default(false)
  thumbnail_url           String?
  category                String?
  instructor_name         String?
  total_duration_seconds  Int?
  difficulty_level        String?
  price                   Int       @default(0)
  is_free                 Boolean   @default(false)
  rating                  Float?    @default(0)
  total_students          Int       @default(0)
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt
  sections     Section[]
  enrollments  Enrollment[]
  payments     Payment[]
  quizzes      Quiz[]
}

model Section {
  id          BigInt   @id @default(autoincrement())
  subject_id  BigInt
  title       String
  order_index Int
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  subject     Subject  @relation(fields: [subject_id], references: [id], onDelete: Cascade)
  videos      Video[]
  @@unique([subject_id, order_index])
}

model Video {
  id               BigInt   @id @default(autoincrement())
  section_id       BigInt
  title            String
  description      String?  @db.Text
  youtube_url      String
  order_index      Int
  duration_seconds Int?
  youtube_video_id String?
  thumbnail_url    String?
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt
  section          Section  @relation(fields: [section_id], references: [id], onDelete: Cascade)
  progress         VideoProgress[]
  notes            Note[]
  bookmarks        Bookmark[]
  comments         Comment[]
  @@unique([section_id, order_index])
}

model Enrollment {
  id         BigInt   @id @default(autoincrement())
  user_id    BigInt
  subject_id BigInt
  created_at DateTime @default(now())
  user       User     @relation(fields: [user_id], references: [id])
  subject    Subject  @relation(fields: [subject_id], references: [id])
  @@unique([user_id, subject_id])
}

model VideoProgress {
  id                   BigInt    @id @default(autoincrement())
  user_id              BigInt
  video_id             BigInt
  last_position_seconds Int      @default(0)
  is_completed         Boolean   @default(false)
  completed_at         DateTime?
  created_at           DateTime  @default(now())
  updated_at           DateTime  @updatedAt
  user                 User      @relation(fields: [user_id], references: [id])
  video                Video     @relation(fields: [video_id], references: [id])
  @@unique([user_id, video_id])
}

model RefreshToken {
  id         BigInt    @id @default(autoincrement())
  user_id    BigInt
  token_hash String
  expires_at DateTime
  revoked_at DateTime?
  created_at DateTime  @default(now())
  user       User      @relation(fields: [user_id], references: [id])
  @@index([user_id, token_hash])
}

model Payment {
  id              BigInt    @id @default(autoincrement())
  user_id         BigInt
  subject_id      BigInt
  amount          Int
  currency        String    @default("INR")
  status          String    @default("pending")
  payment_method  String    @default("dummy")
  transaction_id  String?   @unique
  paid_at         DateTime?
  created_at      DateTime  @default(now())
  user            User      @relation(fields:[user_id], references:[id])
  subject         Subject   @relation(fields:[subject_id], references:[id])
  @@unique([user_id, subject_id])
}

model Note {
  id         BigInt   @id @default(autoincrement())
  user_id    BigInt
  video_id   BigInt
  content    String   @db.Text
  timestamp  Int?     @default(0)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  user       User     @relation(fields: [user_id], references: [id])
  video      Video    @relation(fields: [video_id], references: [id])
}

model Bookmark {
  id         BigInt   @id @default(autoincrement())
  user_id    BigInt
  video_id   BigInt
  timestamp  Int?     @default(0)
  note       String?  @db.Text
  created_at DateTime @default(now())
  user       User     @relation(fields: [user_id], references: [id])
  video      Video    @relation(fields: [video_id], references: [id])
}

model Quiz {
  id          BigInt   @id @default(autoincrement())
  subject_id  BigInt
  title       String
  description String?  @db.Text
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  subject     Subject  @relation(fields: [subject_id], references: [id])
  questions   QuizQuestion[]
  results     QuizResult[]
}

model QuizQuestion {
  id          BigInt   @id @default(autoincrement())
  quiz_id     BigInt
  question    String   @db.Text
  options     Json     // Array of strings
  correct_idx Int      // Index of correct option
  explanation String?  @db.Text
  quiz        Quiz     @relation(fields: [quiz_id], references: [id])
}

model QuizResult {
  id           BigInt   @id @default(autoincrement())
  user_id      BigInt
  quiz_id      BigInt
  score        Int
  answers      Json     // Array of chosen indices
  submitted_at DateTime @default(now())
  user         User     @relation(fields: [user_id], references: [id])
  quiz         Quiz     @relation(fields: [quiz_id], references: [id])
}

model Comment {
  id         BigInt   @id @default(autoincrement())
  user_id    BigInt
  video_id   BigInt
  parent_id  BigInt?
  content    String   @db.Text
  upvotes    Int      @default(0)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  user       User     @relation(fields: [user_id], references: [id])
  video      Video    @relation(fields: [video_id], references: [id])
  parent     Comment? @relation("CommentReplies", fields: [parent_id], references: [id])
  replies    Comment[] @relation("CommentReplies")
}
